# Local development environment for Applied Crafted Energistics (ACE).
#
# Copy this file to `.env` (which is gitignored) and fill in the paths of your own machine.
# The scripts in `tools/` load `.env` automatically; explicit command-line parameters still win.
#
#   PowerShell:  Copy-Item env.example .env
#   Bash:        cp env.example .env

# Root of this repository. Optional: the scripts fall back to their own parent directory.
REPO_ROOT=

# Minecraft launcher data directory (the folder that contains versions/ and libraries/).
# Example: %APPDATA%\.minecraft (the default vanilla location), or a custom launcher folder.
MINECRAFT_ROOT=

# Installed version id, i.e. the folder name under <MINECRAFT_ROOT>/versions/ that the mod is tested in.
VERSION_NAME=

# java.exe used for the test client. Optional: defaults to JAVA_HOME\bin\java.exe, then PATH.
JAVA=

# Throw-away game directory used by the launch harness. Optional: defaults to <repo>/run-instance.
GAME_DIR=
